# Copy to `.env` and fill in what you need. Everything here is optional in
# development: with none of it set, the app runs against a local SQLite file
# and activates plans without taking payment.

# ─── Database ───
# Unset: a SQLite file at web-client/local.db, which is all a dev needs.
# Set: a Turso database (`turso db create caveira`, then `turso db show --url
# caveira` and `turso db tokens create caveira`).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── App ───
# Where this deployment answers. Used for Stripe redirect urls and for the
# device-login link the CLI prints, so it must be the url a browser can reach.
APP_URL=http://localhost:3000

# ─── Stripe (optional — billing) ───
# Without STRIPE_SECRET_KEY the app is in dev billing mode: picking a plan
# writes an active subscription straight to the database, no card involved.
# With it, plan selection opens Stripe Checkout and the webhook is what makes a
# subscription real.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the
# endpoint's signing secret in the dashboard. Without it the webhook refuses
# every delivery rather than trusting an unsigned payload.
STRIPE_WEBHOOK_SECRET=
# One price id per plan in src/lib/plans.ts. A checkout for a plan with no
# price id configured fails loudly instead of charging the wrong amount.
STRIPE_PRICE_RECRUIT=
STRIPE_PRICE_OPERATOR=
STRIPE_PRICE_COMANDO=
