# The root ignores every build/ and dist/; the app keeps its icon, its
# Info.plist templates, and the placeholder go:embed needs in a fresh clone.
!build/
build/bin/
!frontend/dist/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/node_modules/
frontend/wailsjs/
frontend/package.json.md5

# `go build` run in this folder leaves the binary here.
/desktop
